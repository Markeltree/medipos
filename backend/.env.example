# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include the database name, e.g. /medipos
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/medipos?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# How long a login lasts
JWT_EXPIRES_IN=12h

PORT=4000

# Frontend URL(s) allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:3000,https://medipos-peach.vercel.app

# Set to 1 when hosted behind a proxy (Render, Railway, Fly) so rate limits see real client IPs
TRUST_PROXY=0

# Lets an admin reset all pharmacy data to the demo set from Settings. Keep false for a real store.
ALLOW_DEMO_RESET=false

# Used only by `npm run seed`: the password every demo staff account gets
SEED_STAFF_PASSWORD=
